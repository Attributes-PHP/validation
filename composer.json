{
    "name": "attributes-php/validation",
    "type": "library",
    "description": "Pydantic-inspired PHP library for validating data via type hints at lightning speed",
    "keywords": [
        "validation",
        "fast",
        "attributes"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Attributes\\Validation\\": "src/"
        },
        "files": [
            "src/constants.php",
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Attributes\\Validation\\Tests\\": "tests/Integration/",
            "Attributes\\Validation\\Tests\\Benchmark\\": "tests/Benchmark/"
        },
        "classmap": [
            "tests/Integration/Models/"
        ]
    },
    "require-dev": {
        "laravel/pint": "1.20.0",
        "pestphp/pest": "^2.36",
        "phpbench/phpbench": "^1.4"
    },
    "scripts": {
        "lint": "./vendor/bin/pint src",
        "benchmark": "./vendor/bin/phpbench run tests/Benchmark --report=aggregate",
        "test:lint": "./vendor/bin/pint --test src",
        "test:coverage": "./vendor/bin/pest --coverage --parallel",
        "test": [
            "@test:lint",
            "./vendor/bin/pest --colors=always"
        ]
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "pestphp/pest-plugin": true
        }
    }
}
